# Clave de API de Anthropic (Claude) para las funciones de IA.
# Obtenla en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Puerto donde correrá el servidor
PORT=4000

# Origen permitido para CORS (URL del cliente en desarrollo)
CLIENT_ORIGIN=http://localhost:5173

# Modelo de Claude a usar para las funciones de IA
ANTHROPIC_MODEL=claude-sonnet-5
